<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="workflow_condition_step_form_view" model="ir.ui.view">
        <field name="name">workflow.condition.step.form</field>
        <field name="model">workflow.condition.step</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Step Name"/>
                        <h1>
                            <field name="name"
                                   placeholder="e.g. : HR Manager"/>
                        </h1>
                        <label for="sequence" string="Sequence"/>
                        <field name='sequence'/>
                        <field name="model_name" invisible="1"/>
                        <label for="required" string="Required Stage"/>
                        <field name="required"/>
                    </div>
                    <group>
                        <group string="Approval Users">
                            <field name="type"/>
                            <field name="type_user_ids" widget="many2many_tags"
                                   options="{'no_open': True, 'no_create': True}"
                                   invisible="type != 'user'"
                                   required="type == 'user'"/>
                            <field name="type_group_ids" widget="many2many_tags"
                                   options="{'no_open': True, 'no_create': True}"
                                   invisible="type != 'group'"
                                   required="type == 'group'"/>
                            <field name="type_hierarchy_level"
                                   invisible="type != 'hierarchy'"/>
                            <field name="filter_group_id"
                                   invisible="type != 'filter'"
                                   domain="[('model_name', '=', model_name)]"/>
                            <field name="waiting_template_id"  options="{'no_open': True, 'no_create': True}"/>
                        </group>
                        <group string="Notify Users">
                            <field name="notify_type"/>
                            <field name="notify_user_ids"
                                   options="{'no_open': True, 'no_create': True}"
                                   widget="many2many_tags"
                                   invisible="notify_type != 'user'"
                                   required="notify_type == 'user'"/>
                            <field name="notify_group_ids"
                                   options="{'no_open': True, 'no_create': True}"
                                   widget="many2many_tags"
                                   invisible="notify_type != 'group'"
                                   required="notify_type == 'group'"/>
                            <field name="notify_hierarchy_level"
                                   invisible="notify_type != 'hierarchy'"/>
                            <field name="notify_filter_group_id"
                                   invisible="notify_type != 'filter'"
                                   domain="[('model_name', '=', model_name)]"/>
                            <field name="notify_template_id" invisible="not notify_type"
                                   options="{'no_open': True, 'no_create': True}"/>
                        </group>
                        <group>
                            <field name="done_template_id" options="{'no_open': True, 'no_create': True}"/>
                            <field name="required_field_ids" widget="many2many_tags"
                                   domain="[('model', '=', model_name)]"
                                   options="{'no_open': True, 'no_create': True}"/>
<!--                            <field name="required_field_message"/>-->
                            <field name="required_attachment"/>
                            <field name="required_attachment_message" required="required_attachment == True"/>
                            <field name="sla_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Step Actions">
                            <field name="method_action_ids">
                                <tree editable="bottom">
                                    <field name='sequence' widget="handle"/>
                                    <field name="name" placeholder="write the function name only Ex : action_post"/>
                                    <field name="parameter" placeholder="EX : ('name',4)"/>
                                    <field name="type"/>
                                    <field name="description"/>
                                    <field name="step_id"
                                           column_invisible="True"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="res_workflow_from_view" model="ir.ui.view">
        <field name="name">res.workflow.form</field>
        <field name="model">res.workflow</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="create_inherited_view" type="object" string="Update View"></button>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Workflow Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. : Time off"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name='model_id' domain="[('is_mail_thread', '=', True)]"  options="{'no_open': True, 'no_create': True}"/>
                            <field name="category_id" />
                            <field name='res_model' invisible="1"/>
                        </group>
                        <group>
                            <field name="workflow_type" class="o_light_label" widget="radio"
                                   options="{'horizontal': true}"/>
                            <field name="workflow_notify_type" invisible="workflow_type != 'notify'"
                                   required="workflow_type == 'notify'"/>
                            <field name="notify_user_ids"
                                   options="{'no_open': True, 'no_create': True}"
                                   widget="many2many_tags"
                                   invisible="workflow_notify_type != 'user'"
                                   required="workflow_notify_type == 'user'"/>
                            <field name="notify_group_ids"
                                   options="{'no_open': True, 'no_create': True}"
                                   widget="many2many_tags"
                                   invisible="workflow_notify_type != 'group'"
                                   required="workflow_notify_type == 'group'"/>
                            <field name="notify_hierarchy_level"
                                   invisible="workflow_notify_type != 'hierarchy'"/>
                            <field name="notify_filter_group_id"
                                   invisible="workflow_notify_type != 'filter'"
                                   required="workflow_notify_type == 'filter'"
                                   domain="[('model_name', '=', res_model)]"/>
                            <field name="notify_template_id" invisible="workflow_type != 'notify'"
                                   required="workflow_type == 'notify'" options="{'no_open': True, 'no_create': True}"/>
                            <field name="active" invisible="1"/>
                            <field name='company_id' groups="base.group_multi_company"
                                   options="{'no_open': True, 'no_create': True}"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="View Configuration">
                             <group>
                                 <field name="view_to_inherit_id" required="1"/>
                                 <field name="inherited_view_id" invisible="1"/>
                                 <field name="action_on_submit_ids" widget="many2many_tags" domain="[('id', 'in', action_ids)]" options="{'no_create': True}"/>
                                 <field name="approve_method_name" domain="[('id', 'in', action_ids)]" options="{'no_create': True}"/>
                                 <field name="reject_method_name" domain="[('id', 'in', action_ids)]" options="{'no_create': True}"/>
                                 <field name="redraft_method_name" domain="[('id', 'in', action_ids)]" options="{'no_create': True}"/>
                            </group>
                        </page>
                        <page string="Conditions" invisible="workflow_type != 'approval'">
                            <field name="condition_ids" mode="tree" context="{'default_workflow_id': id}">
                                <form string="Conditions">
                                    <sheet>
                                        <div class="oe_title">
                                            <label for="name" string="Condition Name"/>
                                            <h1>
                                                <field name="name"
                                                       placeholder="e.g. :  Annual Leave"/>
                                            </h1>
                                            <field name='workflow_id' invisible='1'/>
                                        </div>
                                        <notebook>
                                            <page string="Path">
                                                <field name="condition_step_ids">
                                                    <tree>
                                                        <field name='sequence' widget="handle"/>
                                                        <field name='name'/>
                                                        <field name='type'/>
                                                        <field name='condition_id' column_invisible="True"/>
                                                    </tree>

                                                </field>
                                            </page>
                                            <page string="Domain">
                                                <field name="model_name" invisible="1"/>
                                                <label for="model_domain" class="oe_edit_only"
                                                       string="Condition To Apply"
                                                       style="width:50%"/>
                                                <div style="width:50%">
                                                    <field name="model_domain" widget="domain"
                                                           options="{'model': 'model_name'}"/>
                                                </div>
                                            </page>
                                        </notebook>
                                    </sheet>
                                </form>
                                <tree>
                                    <field name='sequence' widget="handle"/>
                                    <field name="name"/>
                                    <field name="workflow_id" column_invisible="True"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Actions" invisible="1">
                            <field name="action_ids"  context="{'default_workflow_id':id}">
                                <tree editable="bottom">
                                    <field name='name'/>
                                    <field name='description'/>
                                    <field name="action_type"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Steps" invisible="workflow_type != 'approval'">
                            <field name="step_ids" readonly="1" force_save="1">
                                <tree>
                                    <field name='sequence' widget="handle"/>
                                    <field name="condition_id"/>
                                    <field name="name"/>
                                    <field name="type"/>
                                    <field name="workflow_id" column_invisible="True"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Note">
                            <field name="description" options="{'collaborative': true}"/>
                        </page>
                    </notebook>
                </sheet>
                <!-- Chatter -->
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="res_workflow_tree_view" model="ir.ui.view">
        <field name="name">res.workflow.tree</field>
        <field name="model">res.workflow</field>
        <field name="arch" type="xml">
            <tree string="Workflows">
                <field name="name"/>
                <field name="model_id"/>
                <field name='company_id' groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>
    <record id="res_workflow_view_search" model="ir.ui.view">
        <field name="name">res.workflow.view.search</field>
        <field name="model">res.workflow</field>
        <field name="arch" type="xml">
            <search string="Workflow">
                <field name="name"/>
                <field name="model_id"/>
                <filter name="inactive" string="Archived" domain="[('active','=',False)]"
                        help="Show archived document"/>
            </search>
        </field>
    </record>

    <record id="workflow_action" model="ir.actions.act_window">
        <field name="name">Workflow</field>
        <field name="res_model">res.workflow</field>
        <field name="view_mode">tree,kanban,form</field>
    </record>

    <menuitem name="Workflow Engine"
              id="workflow_menu"
              web_icon="base_workflow,static/description/icon_2.png"
              groups="base_workflow.group_workflow_user"
              sequence="50"/>

    <menuitem name="Workflow Template"
              id="workflow_template_menu"
              action="workflow_action"
              parent="base_workflow.workflow_menu"
              sequence="1"/>
</odoo>