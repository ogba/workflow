        <record id="mail_workflow_notification_create" model="mail.template">
            <field name="name">Workflow Notification: New Request</field>
            <field name="subject">{{ ctx['mail_subject'] }}</field>
            <field name="email_to">{{ ctx['mail_to'] }}</field>
            <field name="email_cc">{{ ctx['mail_cc'] }}</field>
            <field name="model_id" ref="base_workflow_wf.model_workflow_approval_line"/>
            <field name="body_html" type="html">
                <div style="font-family: 'Helvetica Neue', Arial, sans-serif; font-size: 16px; line-height: 1.5; color: #333; background-color: #f4f6f9; padding: 40px; text-align: left; box-sizing: border-box;">
                    <table width="100%" style="max-width: 600px; margin: 0 auto; border-spacing: 0; padding: 0; border-radius: 10px; overflow: hidden;">
                        <tr>
                            <td style="background-color: #003366; padding: 20px; color: white; text-align: center; border-top-left-radius: 10px; border-top-right-radius: 10px;">
                                <!-- Add company logo here -->
                                <img t-att-src="'/base_workflow_wf/static/description/icon_2.png'" alt="Company Logo" style="max-width: 150px;"/>
                                <h2 style="font-size: 24px; margin: 0;">New Request Notification</h2>
                            </td>
                        </tr>
                        <tr>
                            <td style="background-color: #ffffff; padding: 30px; border-bottom: 2px solid #eee; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px;">
                                <p style="font-size: 16px; color: #444; margin: 0;">Dear Team,</p>
                                <p style="font-size: 16px; color: #444; margin: 20px 0;">A new request has been created with the following details:</p>

                                <div style="border-radius: 8px; border: 1px solid #ddd; padding: 20px; background-color: #f9f9f9;">
                                    <table width="100%" style="margin: 20px 0; border-collapse: collapse; text-align: left; border-radius: 8px; overflow: hidden;">
                                        <thead>
                                            <tr style="background-color: #4CAF50; color: white;">
                                                <th colspan="3" style="padding: 10px; font-size: 18px; text-align: center; border-radius: 8px;">Request Details</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td style="padding: 12px; border-bottom: 1px solid #ddd; width: 33%; font-weight: bold;">Request Name:</td>
                                                <td colspan="2" style="padding: 12px; border-bottom: 1px solid #ddd;">
                                                    <t t-esc="ctx.get('request_name')"/>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 12px; border-bottom: 1px solid #ddd; font-weight: bold;">Requester Name:</td>
                                                <td colspan="2" style="padding: 12px; border-bottom: 1px solid #ddd;">
                                                    <t t-esc="ctx.get('requester_name')"/>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 12px; border-bottom: 1px solid #ddd; font-weight: bold;">Requester Code:</td>
                                                <td colspan="2" style="padding: 12px; border-bottom: 1px solid #ddd;">
                                                    <t t-esc="ctx.get('employee_pin')"/>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 12px; border-bottom: 1px solid #ddd; font-weight: bold;">Requester Mobile:</td>
                                                <td colspan="2" style="padding: 12px; border-bottom: 1px solid #ddd;">
                                                    <t t-esc="ctx.get('employee_mobile')"/>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 12px; border-bottom: 1px solid #ddd; font-weight: bold;">Request Number:</td>
                                                <td colspan="2" style="padding: 12px; border-bottom: 1px solid #ddd;">
                                                    <t t-esc="ctx.get('request_number')"/>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 12px; border-bottom: 1px solid #ddd; font-weight: bold;">Request Date:</td>
                                                <td colspan="2" style="padding: 12px; border-bottom: 1px solid #ddd;">
                                                    <t t-if="ctx.get('request_date')">
                                                        <strong t-out="format_datetime(dt=ctx['request_date'], tz=mail_tz, dt_format='yyyy-MM-dd', lang_code=object.env.lang)"></strong>
                                                    </t>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 12px; font-weight: bold;">Request Status:</td>
                                                <td colspan="2" style="padding: 12px;">
                                                    <t t-esc="ctx.get('request_state')"/>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td style="background-color: #ffffff; padding: 20px; text-align: center; font-size: 14px; color: #777;">
                                <p style="font-size: 14px; margin: 0;">
                                    <i>Disclaimer: Please do not reply to this email; it is not monitored. For issues, submit your request through the designated system.</i>
                                </p>
                                <p style="font-size: 14px; margin: 10px 0;">
                                    Best Regards,<br/>

                                    <strong><t t-esc="ctx.get('mail_signature')"/></strong>
                                </p>
                            </td>
                        </tr>
                    </table>
                </div>
            </field>
            <field name="lang">{{ user.lang }}</field>
            <field name="auto_delete" eval="False"/>
        </record>



