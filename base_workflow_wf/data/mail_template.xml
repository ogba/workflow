<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <record id="mail_template_workflow_approval_line_waiting" model="mail.template">
            <field name="name">Workflow Approval: Waiting Notification</field>
            <field name="subject">{{ ctx['mail_subject'] }}</field>
            <field name="email_to">{{ ctx['mail_to'] }}</field>
            <field name="email_cc">{{ ctx['mail_cc'] }}</field>
            <field name="model_id" ref="base_workflow_wf.model_workflow_approval_line"/>
            <field name="body_html" type="html">
                <div style="font-family: 'Helvetica Neue', Arial, sans-serif; font-size: 16px; line-height: 1.5; color: #333; background-color: #f4f6f9; padding: 40px; text-align: left; box-sizing: border-box;">
                    <table width="100%" style="max-width: 600px; margin: 0 auto; border-spacing: 0; padding: 0; border-radius: 10px; overflow: hidden;">
                        <tr>
                            <td style="background-color: #003366; padding: 20px; color: white; text-align: center; border-top-left-radius: 10px; border-top-right-radius: 10px;">
                                <!-- Company Logo -->
                                <img t-att-src="'/base_workflow_wf/static/description/icon_2.png'" alt="Company Logo" style="max-width: 150px;"/>
                                <h2 style="font-size: 24px; margin: 0;">Workflow Approval: Waiting Notification</h2>
                            </td>
                        </tr>
                        <tr>
                            <td style="background-color: #ffffff; padding: 30px; border-bottom: 2px solid #eee; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px;">
                                <p style="font-size: 16px; color: #444; margin: 0;">Dear <t t-out="ctx['line'].name or ''"></t>,</p>
                                <br/>
                                <p>This is request <t t-out="ctx['record'].name or ''"></t> that requires your approval.</p>
                                <br/>
                                <p t-if="ctx.get('access_link')">You can process the request in the following
                                    <a t-att-href="ctx['access_link']"
                                       style="padding: 5px 10px; color: #FFFFFF; text-decoration: none; background-color: #875A7B; border: 1px solid #875A7B; border-radius: 3px">
                                        <t>View</t>
                                    </a>
                                </p>
                                <div style="margin: 0px; padding: 0px;" t-if="ctx.get('request_name')">
                                    <table width="100%" style="font-size: 14px; border-collapse: collapse; margin-top: 20px;">
                                        <tr style="background-color: #875A7B; color: white; text-align: center;">
                                            <td colspan="8" style="padding: 10px;">
                                                <strong style="font-size: 16px;">Request Details</strong>
                                            </td>
                                        </tr>
                                        <tr style="background-color: #f9f9f9;">
                                            <td colspan="2" style="padding: 10px; font-weight: bold;">Requester Name:</td>
                                            <td colspan="6" style="padding: 10px;">
                                                <t t-if="ctx.get('requester_name')">
                                                    <strong t-out="ctx['requester_name'] or ''"></strong>
                                                </t>
                                            </td>
                                        </tr>
                                        <tr style="background-color: #ffffff;">
                                            <td colspan="2" style="padding: 10px; font-weight: bold;">Requester Code:</td>
                                            <td colspan="6" style="padding: 10px;">
                                                <t t-if="ctx.get('employee_pin')">
                                                    <strong t-out="ctx['employee_pin'] or ''"></strong>
                                                </t>
                                            </td>
                                        </tr>
                                        <tr style="background-color: #f9f9f9;">
                                            <td colspan="2" style="padding: 10px; font-weight: bold;">Requester Mobile:</td>
                                            <td colspan="6" style="padding: 10px;">
                                                <t t-if="ctx.get('employee_mobile')">
                                                    <strong t-out="ctx['employee_mobile'] or ''"></strong>
                                                </t>
                                            </td>
                                        </tr>
                                        <tr style="background-color: #ffffff;">
                                            <td colspan="2" style="padding: 10px; font-weight: bold;">Request Number:</td>
                                            <td colspan="6" style="padding: 10px;">
                                                <t t-if="ctx.get('request_number')">
                                                    <strong t-out="ctx['request_number'] or ''"></strong>
                                                </t>
                                            </td>
                                        </tr>
                                        <tr style="background-color: #f9f9f9;">
                                            <td colspan="2" style="padding: 10px; font-weight: bold;">Request Date:</td>
                                            <td colspan="6" style="padding: 10px;">
                                                <t t-if="ctx.get('request_date')">
                                                    <strong t-out="format_datetime(dt=ctx['request_date'], tz=mail_tz, dt_format='yyyy-MM-dd', lang_code=object.env.lang)"></strong>
                                                </t>
                                            </td>
                                        </tr>
                                        <tr style="background-color: #ffffff;">
                                            <td colspan="2" style="padding: 10px; font-weight: bold;">Request Status:</td>
                                            <td colspan="6" style="padding: 10px;">
                                                <t t-if="ctx.get('request_state')">
                                                    <strong t-out="ctx['request_state'] or ''"></strong>
                                                </t>
                                            </td>
                                        </tr>
                                        <tr style="background-color: #f9f9f9;">
                                            <td colspan="2" style="padding: 10px; font-weight: bold;">Approval Stage:</td>
                                            <td colspan="6" style="padding: 10px;">
                                                <t t-if="object.name">
                                                    <strong t-out="object.name"></strong>
                                                </t>
                                            </td>
                                        </tr>
                                        <tr style="background-color: #ffffff;">
                                            <td colspan="2" style="padding: 10px; font-weight: bold;">Approval User:</td>
                                            <td colspan="6" style="padding: 10px;">
                                                <t t-if="object.user_id">
                                                    <strong t-out="object.user_id.name"></strong>
                                                </t>
                                            </td>
                                        </tr>
                                        <tr style="background-color: #f9f9f9;">
                                            <td colspan="2" style="padding: 10px; font-weight: bold;">Approval Status:</td>
                                            <td colspan="6" style="padding: 10px;">
                                                <t t-if="object.status">
                                                    <strong t-out="object.status"></strong>
                                                </t>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td style="background-color: #ffffff; padding: 20px; text-align: center; font-size: 14px; color: #777;">
                                <p style="font-size: 14px; margin: 0;">
                                    <i>Disclaimer: Please do not reply to this email; it is not monitored. For issues, submit your request through the designated system.</i>
                                </p>
                                <p style="font-size: 14px; margin: 10px 0;">
                                    Best Regards,<br/>
                                    <strong><t t-esc="ctx['mail_signature'] or ''"></t></strong>
                                </p>
                            </td>
                        </tr>
                    </table>
                </div>
            </field>
            <field name="auto_delete" eval="False"/>
            <field name="lang">{{ctx['record'].create_uid.lang}}</field>
        </record>


       <record id="mail_workflow_approval_line_done" model="mail.template">
            <field name="name">Workflow Approval: Done Notification</field>
            <field name="subject">{{ctx['mail_subject']}}</field>
            <field name="email_to">{{ctx['mail_to']}}</field>
