<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <!-- This is a comment describing the workflow dashboard section -->
    <t t-name="WFDashboard">
         <div class="oh_dashboards">
            <div class="container-fluid my-5 o_hr_dashboard"/>
        </div>
    </t>
    <!-- This is a comment describing the LoginUser section -->
    <t t-name="LoginUser">
        <section class="dashboard_main_section" id="main_section_login">
            <div class="row">
                <div class="col-sm-12 mb-4">
                    <div class="row">
                        <div class="col-12 col-sm-12 col-md-8">
                            <h2 class="section-header">
                            </h2>
                        </div>
                    </div>
                    <hr/>
                </div>
            </div>
        </section>
    </t>
    <!-- Manager CRM Section -->
    <t t-name="Managercrm">
        <section class="dashboard_main_section"
                 id="main_section_manager">

            <div class="crm_dash_cards row">
                 <t t-foreach="widget.card_wf_category" t-as="card" t-key="card">

                        <div class="col-sm-12 col-md-3">
                            <div class="dashboard-card card-shadow my_lead"
                                    t-att-data-id="card[2]">
                            <div class="dashboard-card__icon-container bg-mauve-light d-flex justify-content-center align-items-center" t-if="card[3] != 'upload'">
                                <i class="fa fa-users text-mauve" t-if="card[3] == 'default'"/>
                                <i t-att-class="'fa ' + card[4] + ' text-mauve'" t-if="card[3] == 'font_aws'"/>
                            </div>
                            <div class="dashboard-card__icon-container  d-flex justify-content-center align-items-center" t-if="card[3] == 'upload'">
                                <img t-att-src="'data:image/png;base64,' + card[5]" t-if="card[3] == 'upload'" style="height: inherit;"/>

                            </div>
                            <div class="dashboard-card__details">
                                <h3>
                                    <span>
                                        <t t-esc="card[1]" />
                                    </span>
                                </h3>

                                <p>
                                    <span>
                                        <t t-esc="card[0]" />
                                    </span>
                                </p>
                            </div>
                        </div>
                        </div>
                 </t>
                <div class="col-sm-12 col-md-3">
                    <div class="dashboard-card card-shadow all_pending_request">
                        <div
                                class="dashboard-card__icon-container  d-flex justify-content-center align-items-center">
                            <img t-att-src="'base_workflow_wf/static/src/img/pendding.png'" style="height: inherit;"/>
                        </div>
                        <div class="dashboard-card__details">
                            <h3>
                                <span>
                                    <t t-esc="widget.get_count_all_wf_request"/>
                                </span>
                            </h3>
                            <p>All Pending Request</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row mt-5">
                <div class="funnel_chart_div col-sm-6 col-md-8">
                     <div class="chart-container card-shadow">
                        <h3>Approval List</h3>
                        <hr/>
                        <table class="table table-hover"
                               id="workflow_approval_table">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Description</th>
                                    <th>Request By</th>
                                    <th>Start Date</th>
                                    <th>Show Item</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="widget.top_workflow_to_approve"
                                   t-as="activity" t-key="activity">
                                    <tr class="chart-container my_approval_list" t-att-data-id="activity[4]">
                                        <td>
                                            <t t-esc="activity[0]" />
                                        </td>
                                        <td>
                                            <t t-esc="activity[1]"/>
                                        </td>
                                        <td>
                                            <t t-esc="activity[3]"/>
                                        </td>
                                         <td>
                                            <t t-esc="activity[2]"  widget="remaining_days"/>
                                        </td>
                                        <td>
                                            <button  title="View Request"  class="btn fa fa-folder-open-o my_approval_list" t-att-data-id="activity[4]"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="col-sm-6 col-md-4">
                    <div class="chart-container card-shadow">
                        <h3>Pending / Done / Delay </h3>
                        <hr/>
                        <div class="graph_canvas">
                            <canvas class="workflow_pie_chart" width="200"
                                    height="120"/>
                        </div>
                    </div>
                </div>
            </div>

        </section>
    </t>
    <!-- Admin CRM Section -->
    <t t-name="Admincrm">
    </t>
</templates>
