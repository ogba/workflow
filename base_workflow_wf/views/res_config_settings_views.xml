<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.workflow</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="80"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Workflow" string="Workflows" name="base_workflow_wf"
                     groups="base_workflow_wf.group_workflow_user">
                    <block title="Workflow" name="workflow_setting_container">
                        <setting id="workflow-delegate" string="Workflow Delegate Domain"
                                 help="Select Delegate domain">
                            <field name="filter_group_id"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="workflow_config_settings_action" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'base_workflow_wf'}</field>
    </record>

    <menuitem id="menu_workflow_config_configuration"
              name="Configuration"
              parent="base_workflow_wf.workflow_menu"
              sequence="99"
              groups="base.group_system"/>

    <menuitem id="workflow_config_settings_menu"
              name="Settings"
              parent="menu_workflow_config_configuration"
              sequence="0"
              action="workflow_config_settings_action"
              groups="base.group_system"/>
</odoo>
