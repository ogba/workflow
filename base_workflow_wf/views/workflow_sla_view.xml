<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="workflow_sla_from_view" model="ir.ui.view">
        <field name="name">workflow.sla.form</field>
        <field name="model">workflow.sla</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title mw-75 ps-0 pe-2">
                        <label for="name" string="Reference"/>
                        <h1>
                            <field name="name" placeholder="e.g. : Manager SLA"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name='period_type'/>
                            <field name='sla_value'/>

                            <field name='reminder_value'/>
                        </group>
                        <group>
                            <field name="sla_template_id"/>
                            <field name="reminder_template_id"/>
                            <field name='company_id' groups="base.group_multi_company"
                                   options="{'no_open': True, 'no_quick_create': True}"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="sla_property_ids">
                                <tree>
                                    <field name='sequence' widget="handle"/>
                                    <field name="action_type"/>
                                    <field name="sla_id"
                                           column_invisible="True"/>
                                </tree>
                                <form>
                                    <sheet>
                                        <group>
                                            <label for="sequence" string="Sequence"/>
                                            <field name='sequence' placeholder="Sequence"/>
                                            <group>
                                                <field name="action_type"/>
                                                <field name="filter_group_id" attrs="{'invisible': [('action_type', '!=', 'escalate_filter')], 'required': [('action_type', '=', 'escalate_filter')]}"/>
                                                <field name="group_id" attrs="{'invisible': [('action_type', '!=', 'escalate_group')], 'required': [('action_type', '=', 'escalate_group')]}"/>
                                                <field name="hierarchy_level" attrs="{'invisible': [('action_type', '!=', 'escalate_hrc')], 'required': [('action_type', '=', 'escalate_hrc')]}"/>

                                            </group>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <!-- Chatter -->
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="workflow_sla_tree_view" model="ir.ui.view">
        <field name="name">workflow.sla.tree</field>
        <field name="model">workflow.sla</field>
        <field name="arch" type="xml">
            <tree string="SLA">
                <field name="name" string="Reference"/>
                <field name='period_type'/>
                <field name='company_id' groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="workflow_sla_action" model="ir.actions.act_window">
        <field name="name">Workflow SLA</field>
        <field name="res_model">workflow.sla</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem name="Workflow SLA"
              id="workflow_sla_menu"
              action="workflow_sla_action"
              parent="base_workflow_wf.menu_workflow_config_configuration"
              sequence="3"/>
</odoo>