<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="workflow_request_from_view" model="ir.ui.view">
        <field name="name">workflow.request.form</field>
        <field name="model">workflow.request</field>
        <field name="arch" type="xml">
            <form>
                <header>

                <field name="status" widget="statusbar"
                               class="oe_inline oe_right"/>
                <button name="approve" type="object" string="Approve request"  invisible="status == 'approved'"/>
                <button name="approve" type="object" string="Approve request2"  invisible="status == 'approved'"/>
                <button name="approve" type="object" string="Approve request3"  invisible="status == 'approved'"/>
                <button name="reject" type="object" string="Reject request" class="btn btn-danger" invisible="status == 'rejected'"/>

                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Reference"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name='employee_id' options="{'no_open': True, 'no_quick_create': True}"/>
                        </group>
                        <group>
                            <field name="date"/>
                        </group>
                        <field name="description"/>
                    </group>
                </sheet>
                <!-- Chatter -->
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="workflow_request_tree_view" model="ir.ui.view">
        <field name="name">workflow.request.tree</field>
        <field name="model">workflow.request</field>
        <field name="arch" type="xml">
            <list string="Workflows">
                <field name="name"/>
                <field name="employee_id"/>
                <field name='company_id' groups="base.group_multi_company"/>
                <field name="approval_status" widget="badge" decoration-success="approval_status == 'approved'"
                       decoration-info="approval_status == 'pending'"
                       decoration-danger="approval_status == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="workflow_request_action" model="ir.actions.act_window">
        <field name="name">Request</field>
        <field name="res_model">workflow.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem name="Requests"
              id="workflow_request_menu"
              action="workflow_request_action"
              parent="base_workflow_wf.workflow_menu"
              sequence="3"/>
</odoo>