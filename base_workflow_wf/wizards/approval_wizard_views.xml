<odoo>

    <record id="approval_wizard_view_form" model="ir.ui.view">
        <field name="name">Approval Comment</field>
        <field name="model">approval.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="model_name" invisible="1"/>
                <field name="res_id" invisible="1"/>
                <sheet>
                    <h1>Please insert reason.</h1>
                    <group>
                        <field name="reference" force_save="1" invisible="1"/>
                        <field name="status" force_save="1" invisible="1"/>
                        <field name="required_approval" force_save="1" invisible="1"/>
                        <field name="approval_line_id" options="{'no_open': True, 'no_create': True}"
                               invisible="not required_approval" required="required_approval"
                               domain="[('res_model', '=', model_name), ('res_id', '=', res_id),('status', '=', 'approved')]"/>
                        <field name="user_ids" widget="many2many_tags" invisible="status not in ('rmi','forward')"
                               options="{'no_open': True, 'no_create': True}" required="status in ('rmi','forward')"/>
                        <field name="reason" required="1"/>
                    </group>
                    <group>
                        <field name="attachment_ids" widget="many2many_binary" nolabel="1"
                               colspan="2"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Confirm" class="btn-primary" name="action_confirm" type="object"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="approval_wizard_action" model="ir.actions.act_window">
        <field name="name">Approval Comment</field>
        <field name="res_model">approval.wizard</field>
        <field name="view_mode">form</field>
    </record>

</odoo>
